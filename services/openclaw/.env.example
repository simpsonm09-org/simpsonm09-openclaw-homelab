# Copy this file to .env in this directory and fill in the values.
# Never commit .env. It is git-ignored.

# The Gateway token. Generate one with: openssl rand -hex 32
# This value also replaces the placeholder in the deployed config.
OPENCLAW_GATEWAY_TOKEN=

# The container image, pinned once Phase 1 of docs/setup-plan.md verifies it.
OPENCLAW_IMAGE=
